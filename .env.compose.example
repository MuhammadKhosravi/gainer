# Copy to .env; replace BOTH placeholders with separate `openssl rand -hex 32` outputs.
# Use a hexadecimal database password so it is safe in the connection URL.
POSTGRES_PASSWORD=replace-with-a-random-hex-password
BETTER_AUTH_SECRET=replace-with-a-different-random-secret
BETTER_AUTH_URL=http://localhost:3000
APP_PORT=3000
